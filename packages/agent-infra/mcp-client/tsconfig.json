{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": false,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "declaration": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
